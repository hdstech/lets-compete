# Copy this file to `.env` for local development. Never commit real values —
# `.env` is git-ignored; only this example file is tracked.

# ── Client (Vite) ──────────────────────────────────────────────────────────
# Exposed in the browser bundle. Safe to ship: Row Level Security is the real
# security boundary, so the publishable/anon key is meant to be public.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ── Server (Vercel functions / keep-alive cron) ────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables.
# SUPABASE_SECRET_KEY is the SECRET key (sb_secret_...) — server-only, never
# exposed to the browser. The keep-alive pings an endpoint that requires it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Random string. Vercel sends it to the cron as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=replace-with-a-long-random-string
