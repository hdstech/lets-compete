# Copy this file to `.env` for local development. Never commit real values —
# `.env` is git-ignored; only this example file is tracked.

# ── Client (Vite) ──────────────────────────────────────────────────────────
# Exposed in the browser bundle. Safe to ship: Row Level Security is the real
# security boundary, so the publishable/anon key is meant to be public.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# ── Server (Vercel functions / keep-alive cron) ────────────────────────────
# Set these in Vercel → Project → Settings → Environment Variables.
# SUPABASE_SECRET_KEY is the SECRET key (sb_secret_...) — server-only, never
# exposed to the browser. The keep-alive pings an endpoint that requires it.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx
# Random string. Vercel sends it to the cron as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=replace-with-a-long-random-string

# ── Playwright e2e (`npm run test:e2e`) ────────────────────────────────────
# Optional — the suite falls back to these same defaults when unset. Reuses
# one organizer account across runs (signing up on first use) rather than
# creating a new one every run, since the anon key can't delete auth users.
E2E_ORGANIZER_EMAIL=playwright-e2e-organizer@example.com
E2E_ORGANIZER_PASSWORD=playwright-e2e-password
# Participants sign in via magic link in production, which can't be scripted,
# so this account authenticates over Supabase's password grant directly
# instead (participant.setup.ts) — same reused-account rationale as above.
E2E_PARTICIPANT_EMAIL=playwright-e2e-participant@example.com
E2E_PARTICIPANT_PASSWORD=playwright-e2e-password
# Graders also sign in via magic link in production; same password-grant
# bypass as the participant account above (grader.setup.ts).
E2E_GRADER_EMAIL=playwright-e2e-grader@example.com
E2E_GRADER_PASSWORD=playwright-e2e-password
