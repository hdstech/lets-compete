meta {
  name: [Final Round Setup] Auto-Mark Question 2 Answers
  type: http
  seq: 5
}

post {
  url: {{base_url}}/rest/v1/rpc/auto_mark_question_answers
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{admin_jwt}}
  Content-Type: application/json
}

body:json {
  {
    "p_question_id": "{{question2_id}}"
  }
}

script:post-response {
  test("question 2 auto-marked (200)", function () {
      expect([200]).to.include(res.status);
  });
}

docs {
  Run at least 10s after the previous request (QA6/QA7's shared grace period). Replays QA7's auto_mark_question_answers.
}
