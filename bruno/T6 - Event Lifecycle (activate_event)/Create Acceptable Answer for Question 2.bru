meta {
  name: Create Acceptable Answer for Question 2
  type: http
  seq: 15
}

post {
  url: {{base_url}}/rest/v1/question_acceptable_answers
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{admin_jwt}}
  Content-Type: application/json
  Prefer: return=representation
}

body:json {
  {
    "question_id": "{{question2_id}}",
    "value": "12",
    "is_numeric": true
  }
}

script:post-response {
  if (res.status < 300) {
      const json = res.body;
      const value = Array.isArray(json) ? json[0].id : json.id;
      if (value) {
          bru.setEnvVar("acceptable_answer2_id", value);
      }
  }
  test("status is 2xx", function () {
      expect(res.status).to.be.below(300);
  });
}

docs {
  is_numeric=true — matched via private.parse_numeric_answer equality rather than normalized text. Captures {{acceptable_answer2_id}}.
}
