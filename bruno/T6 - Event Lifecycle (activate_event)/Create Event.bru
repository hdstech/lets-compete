meta {
  name: Create Event
  type: http
  seq: 1
}

post {
  url: {{base_url}}/rest/v1/events
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{admin_jwt}}
  Content-Type: application/json
  Prefer: return=representation
}

body:json {
  {
    "name": "T18 Regression Quiz",
    "event_date": "2026-09-01",
    "organizer_id": "{{admin_user_id}}",
    "format": "quiz",
    "has_rounds": true,
    "grader_id": "{{grader_user_id}}"
  }
}

script:post-response {
  if (res.status < 300) {
      const json = res.body;
      const row = Array.isArray(json) ? json[0] : json;
      if (row) {
          bru.setEnvVar("event_id", row.id);
          bru.setEnvVar("join_code", row.join_code);
      }
  }
  test("event created (2xx)", function () {
      expect([200,201]).to.include(res.status);
  });
}

docs {
  Prerequisite for activate_event: creates a draft quiz event owned by the admin/organizer, with grader_id set to the seeded grader test user (QA2's single-grader identity column — required for QA10's adjudicate_round_answers to authorize later). join_code is left out of the body so T10's events_generate_join_code trigger fills it; format='quiz' is set once and is immutable thereafter (QA0). Captures {{event_id}} and {{join_code}}.
}
