meta {
  name: Create Question To Void (Round 1)
  type: http
  seq: 11
}

post {
  url: {{base_url}}/rest/v1/questions
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{admin_jwt}}
  Content-Type: application/json
  Prefer: return=representation
}

body:json {
  {
    "segment_id": "{{segment1_id}}",
    "prompt": "Question reserved for the QA8 void demo",
    "answer_type": "text",
    "window_seconds": 20,
    "sequence": 3,
    "is_tiebreak": false
  }
}

script:post-response {
  if (res.status < 300) {
      const json = res.body;
      const value = Array.isArray(json) ? json[0].id : json.id;
      if (value) {
          bru.setEnvVar("question3_id", value);
      }
  }
  test("status is 2xx", function () {
      expect(res.status).to.be.below(300);
  });
}

docs {
  A throwaway question reserved for the QA8 void_question demo, so voiding it doesn't disturb the main live-play scoring path. Captures {{question3_id}}.
}
