meta {
  name: Create Acceptable Answer for Tiebreak Question
  type: http
  seq: 13
}

post {
  url: {{base_url}}/rest/v1/question_acceptable_answers
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{admin_jwt}}
  Content-Type: application/json
  Prefer: return=representation
}

body:json {
  {
    "question_id": "{{tiebreak_reserve_question_id}}",
    "value": "Tokyo",
    "is_numeric": false
  }
}

script:post-response {
  if (res.status < 300) {
      const json = res.body;
      const value = Array.isArray(json) ? json[0].id : json.id;
      if (value) {
          bru.setEnvVar("acceptable_answer3_id", value);
      }
  }
  test("status is 2xx", function () {
      expect(res.status).to.be.below(300);
  });
}

docs {
  Captures {{acceptable_answer3_id}}.
}
