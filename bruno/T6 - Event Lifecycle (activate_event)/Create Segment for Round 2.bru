meta {
  name: Create Segment for Round 2
  type: http
  seq: 7
}

post {
  url: {{base_url}}/rest/v1/segments
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{admin_jwt}}
  Content-Type: application/json
  Prefer: return=representation
}

body:json {
  {
    "round_id": "{{round2_id}}",
    "name": "Final Segment",
    "sequence": 1
  }
}

script:post-response {
  if (res.status < 300) {
      const json = res.body;
      const value = Array.isArray(json) ? json[0].id : json.id;
      if (value) {
          bru.setEnvVar("segment2_id", value);
      }
  }
  test("status is 2xx", function () {
      expect(res.status).to.be.below(300);
  });
}

docs {
  Captures {{segment2_id}}.
}
