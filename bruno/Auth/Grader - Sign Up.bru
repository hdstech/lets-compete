meta {
  name: Grader - Sign Up
  type: http
  seq: 5
}

post {
  url: {{base_url}}/auth/v1/signup
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
  Content-Type: application/json
}

body:json {
  {
    "email": "{{grader_email}}",
    "password": "{{grader_password}}",
    "data": {
      "name": "Grader"
    }
  }
}

script:post-response {
  if (res.status < 300) {
      const json = res.body;
      if (json.access_token) {
          bru.setEnvVar("grader_jwt", json.access_token);
      }
      if (json.user && json.user.id) {
          bru.setEnvVar("grader_user_id", json.user.id);
      }
  }
  test("received an access_token (or user already exists)", function () {
      expect([200, 400, 422]).to.include(res.status);
  });
}

docs {
  GoTrue signup for the seeded Grader test user. Requires Email auth enabled and "confirm email" disabled in the Supabase dashboard (T4's own migration comment flags this as a manual step) so the response includes a session directly. On success, captures {{grader_jwt}} and {{grader_user_id}} for every downstream request. Safe to re-run: a 422/400 "already registered" is expected on repeat runs — use the matching Log In request instead in that case.
}
