meta {
  name: Admin - Blocked: Insert Answer
  type: http
  seq: 3
}

post {
  url: {{base_url}}/rest/v1/answers
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{admin_jwt}}
  Content-Type: application/json
}

body:json {
  {
    "participant_id": "00000000-0000-0000-0000-000000000000",
    "question_id": "00000000-0000-0000-0000-000000000000",
    "round_id": "00000000-0000-0000-0000-000000000000",
    "segment_id": "00000000-0000-0000-0000-000000000000",
    "submitted_text": "Should Be Rejected"
  }
}

script:post-response {
  test("organizer insert is rejected by RLS (403)", function () {
      expect([403]).to.include(res.status);
  });
}

docs {
  QA2 RLS: answers_insert_own_open requires private.owns_participant(participant_id) — true only for the approved participant who owns that row. The organizer owns no participant row, so this insert (against nil participant/question/round/segment ids) must be rejected even though the organizer has broad structural access elsewhere. Proves "admin is read-only on answers".
}
