meta {
  name: Participant - Blocked: Insert Round
  type: http
  seq: 1
}

post {
  url: {{base_url}}/rest/v1/rounds
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{participant_jwt}}
  Content-Type: application/json
}

body:json {
  {
    "event_id": "00000000-0000-0000-0000-000000000000",
    "name": "Should Be Rejected",
    "sequence": 1,
    "is_final_round": false,
    "advancement_n": 1
  }
}

script:post-response {
  test("participant insert is rejected by RLS (403)", function () {
      expect([403]).to.include(res.status);
  });
}

docs {
  QA2 RLS: rounds_insert_organizer only allows the event organizer to insert. A participant attempting to insert a round (even against a non-existent event id — private.is_event_organizer() simply evaluates false and RLS rejects the row before any FK is checked) must be rejected. Proves the participant role cannot write event structure.
}
