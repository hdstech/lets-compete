meta {
  name: Reveal Question 1
  type: http
  seq: 1
}

post {
  url: {{base_url}}/rest/v1/rpc/reveal_question
  body: json
  auth: none
}

headers {
  apikey: {{anon_key}}
  Authorization: Bearer {{admin_jwt}}
  Content-Type: application/json
}

body:json {
  {
    "p_question_id": "{{question1_id}}"
  }
}

script:post-response {
  if (res.status < 300) {
      const json = res.body;
      if (json.reveal_token) { bru.setEnvVar("question1_reveal_token", json.reveal_token); }
  }
  test("question revealed (200)", function () {
      expect([200]).to.include(res.status);
  });
}

docs {
  QA5's reveal_question(p_question_id): organizer-only, requires the question pending in an active event whose round is scoring_open. Stamps revealed_at + a fresh reveal_token and opens the answer window (status=window_open). Captures {{question1_reveal_token}}. window_seconds=20, so downstream requests in this folder and QA6/QA7 are timing-sensitive — see each request's description.
}
